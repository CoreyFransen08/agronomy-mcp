# Fleetio MCP Server — Development Variables
# Copy this file to .dev.vars and fill in your values.
#
# Find your API key under User Settings in Fleetio.
# Find your Account Token in your Fleetio account settings.
FLEETIO_API_KEY=your-fleetio-api-key-here
FLEETIO_ACCOUNT_TOKEN=your-fleetio-account-token-here
