{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fleetio-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat"],

  /**
   * Secrets (set via `npx wrangler secret put <NAME>`):
   *   COOKIE_ENCRYPTION_KEY  — random string for encrypting session cookies
   */

  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "<your-oauth-kv-namespace-id>"
    },
    {
      "binding": "CACHE",
      "id": "<your-cache-kv-namespace-id>"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "FleetioMCP"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FleetioMCP"]
    }
  ],

  "observability": {
    "enabled": true
  },

  "dev": {
    "port": 8788
  }
}
